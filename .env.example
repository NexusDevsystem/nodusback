PORT=3001
NODE_ENV=production

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nodus?retryWrites=true&w=majority

# CORS & Frontend URLs
CORS_ORIGIN=https://www.nodus.my
FRONTEND_URL=https://www.nodus.my
ALLOWED_ORIGINS=https://www.nodus.my,https://nodus.my
FRONTEND_ALLOWED_ORIGINS=https://www.nodus.my,https://nodus.my

# Auth Secrets
JWT_SECRET=replace-with-a-long-random-secret
RESET_SECRET=replace-with-another-long-random-secret
OAUTH_STATE_SECRET=replace-with-a-third-long-random-secret

# EmailJS Configuration
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Twitch Integration
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/api/integrations/twitch/callback

# Kick Integration
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3001/api/integrations/kick/callback
