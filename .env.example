# Runtime
NODE_ENV=development
PORT=3001
BACKEND_URL=http://localhost:3001
PUBLIC_BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Auth and database — generate unique secrets; never commit real values
JWT_SECRET=replace-with-a-long-random-secret
RESET_SECRET=replace-with-another-long-random-secret
OAUTH_STATE_SECRET=replace-with-a-third-long-random-secret
SUPERADMIN_EMAILS=
SUPERADMIN_USER_IDS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key

# Billing
ABACATE_PAY_TOKEN=
ABACATE_PAY_PRODUCT_ID_ANNUAL=
ABACATE_PAY_WEBHOOK_SECRET=

# EmailJS password reset / incomplete-link notifications
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_LINKS_SERVICE_ID=
EMAILJS_LINKS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAIL_REPLY_TO=

# OAuth integrations (only configure providers in use)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/integrations/instagram/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3001/api/integrations/tiktok/callback
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3001/api/integrations/twitch/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/integrations/youtube/callback
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3001/api/integrations/kick/callback
META_WEBHOOK_VERIFY_TOKEN=
