{
    "name": "nodus-backend",
    "version": "1.0.0",
    "description": "Backend API for Nodus - Link in Bio platform",
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "start": "node dist/server.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.json --watch"
    },
    "overrides": {
        "qs": "^6.16.0"
    },
    "keywords": [
        "api",
        "express",
        "nodus"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@supabase/supabase-js": "^2.39.3",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "axios": "^1.13.5",
        "bcrypt": "^6.0.0",
        "cheerio": "^1.2.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "file-type": "^22.1.1",
        "googleapis": "^171.4.0",
        "helmet": "^8.1.0",
        "hpp": "^0.2.3",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.0.2",
        "nodemailer": "^10.0.10",
        "pg": "^8.18.0",
        "sharp": "^0.35.4",
        "typescript": "^5.3.3",
        "xss": "^1.0.15"
    },
    "devDependencies": {
        "@jest/globals": "^30.3.0",
        "@types/bcrypt": "^6.0.0",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.0.0",
        "@types/nodemailer": "^7.0.11",
        "@types/pg": "^8.16.0",
        "@types/supertest": "^7.2.0",
        "jest": "^30.3.0",
        "supertest": "^7.2.2",
        "ts-jest": "^29.4.6",
        "tsx": "^4.7.0"
    }
}
